# Railway / Node
PORT=8080
NODE_ENV=production

# Railway PostgreSQL
DATABASE_URL=postgresql://user:password@host:port/database

# Super Admin bootstrap / emergencia
PANEL_ADMIN_USER=facundo
PANEL_ADMIN_PASSWORD=CAMBIAR_ESTA_CLAVE
JWT_SECRET=CAMBIAR_POR_UNA_CLAVE_LARGA_Y_ALEATORIA

# Debe coincidir con DLL_ONE_BRIDGE_KEY del Apps Script actual
PANEL_SYNC_KEY=PEGAR_DLL_ONE_BRIDGE_KEY

# Copiar EXACTAMENTE la misma URL que usa dll-one-v4-motor
APPS_SCRIPT_BRIDGE_URL=https://script.google.com/macros/s/XXXXXXXX/exec

# Opcional
PANEL_BRAND_NAME=DLL ONE


# URL pública del motor actual de WhatsApp.
# Ejemplo:
DLL_ONE_MOTOR_URL=https://dll-one-v4-motor-production.up.railway.app
MOTOR_TIMEOUT_MS=7000
